@using WordCollector.Shared

<EditForm Model="@_newWord" class="card p-3 mb-4">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mt-2 mb-0" />

    <div class="row g-2">
        <div class="col-md-5">
            <label class="form-label">New Word</label>
            <InputText @bind-Value="_newWord.Word" class="form-control" placeholder="Enter word..." />
        </div>
        <div class="col-md-4">
            <InputSelect @bind-Value="_newWord.Type" class="form-select">
                @foreach (var type in Enum.GetValues<WordType>())
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
        </div>
    </div>

</EditForm>
