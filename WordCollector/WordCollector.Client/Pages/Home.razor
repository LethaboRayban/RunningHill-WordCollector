@page "/"
@using Microsoft.AspNetCore.Components.QuickGrid
@using WordCollector.Client.Pages.Shared

<button class="btn btn-primary" @onclick="() => OpenWordEntryModal(null)">Add Word</button>

<Modal IsVisible="isModalVisible"
       Title="@modalTitle"
       FormComponentType="typeof(WordForm)"
       FormParameters="formParameters"
       OnClose="() => isModalVisible = false" />


if (!words.Any())
{
    <p>Loading...</p>
}
else
{
    <div class="table-responsive shadow-sm rounded border">
        <QuickGrid Items="@words.AsQueryable()" Class="table table-hover table-striped align-middle mb-0">
            <TemplateColumn Title="Actions">
                <button @onclick="() => OpenWordEntryModal(context)">Edit</button>
            </TemplateColumn>
            <PropertyColumn Property="@(x => x.Id)" Sortable="true" />
            <PropertyColumn Property="@(x => x.Word)" Sortable="true" />
            <PropertyColumn Property="@(x => x.Type)" Sortable="true" />
        </QuickGrid>
    </div>
}

